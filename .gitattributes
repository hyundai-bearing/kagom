# 줄바꿈: 레포에는 LF로 저장하고, 작업 폴더에서는 각자 OS(core.autocrlf)에 맞춘다
* text=auto

# 실행 스크립트는 OS에 맞는 줄바꿈으로 고정
gradlew text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 바이너리 (줄바꿈 변환·diff 안 함)
*.png  binary
*.jpg  binary
*.webp binary
*.ttf  binary
*.glb  binary
*.zip  binary
*.pdf  binary
*.jar  binary
*.mp4  binary
